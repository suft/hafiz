<?xml version="1.0" encoding="utf-8"?>
<!--
  Google Play Games Services configuration. While game_services_project_id is empty, all
  Play Games code stays dormant (no Leaderboards card, no SDK init). Debug builds never use
  Play Games regardless of these values.

  Setup:
  1. Create the game project in Play Console -> Play Games Services -> Configuration.
     Paste the project ID into game_services_project_id.
  2. Create 8 leaderboards (Mutashabihat has no Where's the Ayah? board): Numeric, 0 decimals, "Larger is better". Paste each ID into the
     matching string below. A board whose ID is left empty is simply skipped.
  3. Each board's score is the sum of the player's best score on every level of that question
     style in that mode. Regular: best round score per level. Survival: best game per level.
     Mutashabihat: best game (whole Quran only).
  4. Add Android credentials for package suft.android.hafiz with the SHA-1 of the upload key
     (release.jks) and of the Play app-signing key. While the game is unpublished, add test
     accounts as testers.
-->
<resources>
    <string name="game_services_project_id" translatable="false"></string>

    <string name="leaderboard_regular_surah" translatable="false"></string>
    <string name="leaderboard_regular_ayah" translatable="false"></string>
    <string name="leaderboard_regular_position" translatable="false"></string>
    <string name="leaderboard_survival_surah" translatable="false"></string>
    <string name="leaderboard_survival_ayah" translatable="false"></string>
    <string name="leaderboard_survival_position" translatable="false"></string>
    <string name="leaderboard_mutashabihat_surah" translatable="false"></string>
    <string name="leaderboard_mutashabihat_ayah" translatable="false"></string>
</resources>
